# AWS ECS Deployment Configuration
# Copy this file and update with your actual values

# AWS Configuration
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=  # Leave empty to auto-detect

# ECS Configuration
CLUSTER_NAME=chirp-cluster
SERVICE_NAME=chirp-radio-frontend
TASK_FAMILY=chirp-radio-frontend
ECR_REPO_NAME=chirp-radio-frontend
CONTAINER_NAME=chirp-radio-frontend
CONTAINER_PORT=80

# CMS Configuration
# IMPORTANT: Update this with your actual CMS service name
CMS_SERVICE_NAME=chirp-cms  # Name of your CMS ECS service
CMS_PORT=3000

# Network Configuration
# Get these from your existing CMS deployment
VPC_ID=  # e.g., vpc-0123456789abcdef0
SUBNET_IDS=  # e.g., subnet-xxxxx,subnet-yyyyy (comma-separated, min 2 for ALB)
SECURITY_GROUP_ID=  # e.g., sg-0123456789abcdef0

# Load Balancer Configuration
CREATE_ALB=true  # Set to false if you don't need an ALB
ALB_NAME=chirp-radio-alb
TARGET_GROUP_NAME=chirp-radio-tg
CERTIFICATE_ARN=  # Optional: ACM certificate ARN for HTTPS (e.g., arn:aws:acm:us-east-2:...)

# Resource Configuration
CPU=256  # 0.25 vCPU (options: 256, 512, 1024, 2048, 4096)
MEMORY=512  # MB (options depend on CPU - see AWS Fargate docs)
DESIRED_COUNT=1  # Number of tasks to run

# How to find these values:
# ========================

# 1. Get VPC ID:
#    aws ec2 describe-vpcs --region us-east-2

# 2. Get Subnet IDs (need at least 2 in different AZs):
#    aws ec2 describe-subnets --region us-east-2 --filters "Name=vpc-id,Values=YOUR_VPC_ID"

# 3. Get Security Group ID:
#    aws ec2 describe-security-groups --region us-east-2 --filters "Name=vpc-id,Values=YOUR_VPC_ID"

# 4. Get CMS Service Name:
#    aws ecs list-services --cluster chirp-cluster --region us-east-2
#    aws ecs describe-services --cluster chirp-cluster --services SERVICE_ARN --region us-east-2

# 5. Get ACM Certificate ARN (optional, for HTTPS):
#    aws acm list-certificates --region us-east-2
